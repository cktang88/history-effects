# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any OpenRouter model slug; leave unset for the default (anthropic/claude-haiku-5.5).
# Examples: anthropic/claude-sonnet-5.5, anthropic/claude-opus-5.5
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Reasoning effort: off | minimal | low | medium | high (default: low).
# Higher is slower to first result; "low" keeps exploration snappy.
OPENROUTER_REASONING=low

# Set to 1 to serve canned, streamed responses without calling OpenRouter
# (for UI development and demos). Same as `bun run dev:mock`.
# MOCK_LLM=1

# Server port
PORT=3000
